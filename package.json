{
  "name": "plotted",
  "private": true,
  "workspaces": ["web", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "test": "npm test -w @plotted/engine",
    "lint": "npm run lint -w web",
    "typecheck": "npm run typecheck -w @plotted/engine && npx -w web tsc --noEmit",
    "data": "cd scraper && uv run plotted-scrape"
  }
}
